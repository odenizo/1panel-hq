# GitHub Configuration
# Get GITHUB_TOKEN from: https://github.com/settings/tokens
# Required scopes: admin:repo_hook, admin:org_hook, admin:gpg_key, admin:public_key, admin:self_hosted_runner
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Owner (username or organization)
# Example: odenizo or my-org-name
GITHUB_OWNER=odenizo

# GitHub Repository (leave blank for organization-level runner, or specify repo)
# Example: 1panel-hq or leave empty for org-wide runner
GITHUB_REPOSITORY=

# Runner Configuration
# Unique name for this runner (will appear in GitHub Settings > Actions > Runners)
RUNNER_NAME=runner-hetzner-1

# Labels for targeting workflows (comma-separated, no spaces)
# These labels help you target this runner in GitHub Actions workflows
RUNNER_LABELS=hetzner,1panel,self-hosted,linux,docker

# Working directory for runner
# Do NOT change unless you know what you're doing
RUNNER_WORK_DIRECTORY=/home/runner

# Ephemeral Mode
# Set to 'true' for ephemeral runners (auto-cleanup after each job, recommended for security)
# Set to 'false' for persistent runners (longer-lived, better for performance)
RUNNER_EPHEMERAL=false

# Optional: Proxy Configuration
# Uncomment and set if your network requires a proxy
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.example.com

# Optional: Docker Configuration
# Allows runner to build and push Docker images
DOCKER_BUILDKIT=1
BUILDKIT_PROGRESS=plain
